{
  "redirects": [
    {
      "source": "/:page(pagina01|pagina02|pagina03|pagina04|bio|paginabio|raiox01|raiox02|raiox03|vsl01v1|raioxvsl1)",
      "destination": "/:page/",
      "permanent": true
    },
    {
      "source": "/raiox06/",
      "destination": "/exercicioraiox/",
      "permanent": true
    },
    {
      "source": "/raiox06/:path*",
      "destination": "/exercicioraiox/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "quiz.brunosimplicio.com.br"
        }
      ],
      "destination": "/raiox01/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "origem.brunosimplicio.com.br"
        }
      ],
      "destination": "/origem-da-doenca/"
    }
  ],
  "headers": [
    {
      "source": "/pagina01/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:page(pagina01|bio)/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:page(pagina02|pagina03|pagina04|bio)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
